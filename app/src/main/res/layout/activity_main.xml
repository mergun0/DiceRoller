<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/titleText"
            style="@style/TextAppearance.Material3.HeadlineLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/modeControl"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/mode_control_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/singleModeButton"
                android:layout_width="108dp"
                android:layout_height="match_parent"
                android:background="@drawable/mode_pill_selected_bg"
                android:clickable="true"
                android:contentDescription="@string/single_mode_accessibility"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/single_dice"
                android:textColor="@color/text_on_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/doubleModeButton"
                android:layout_width="108dp"
                android:layout_height="match_parent"
                android:background="@drawable/mode_pill_unselected_bg"
                android:clickable="true"
                android:contentDescription="@string/double_mode_accessibility"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/double_dice"
                android:textColor="@color/primary_navy"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sceneCard"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="28dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/outline_soft"
            app:strokeWidth="1dp">

            <FrameLayout
                android:id="@+id/diceStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/scene_spotlight"
                android:contentDescription="@string/dice_area" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/secondary_soft"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/resultText"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="148dp"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="10dp"
                android:gravity="center"
                android:text="@string/result_placeholder"
                android:textColor="@color/primary_navy" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/rollButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/roll_button_bg"
            android:clickable="true"
            android:contentDescription="@string/roll_dice"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/roll_dice"
            android:textColor="@color/text_on_accent"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
