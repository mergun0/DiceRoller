<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_background"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp">

    <ImageView
        android:id="@+id/brandLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@string/app_name"
        android:scaleX="0.96"
        android:scaleY="0.96"
        android:src="@drawable/ic_brand_dice"
        app:layout_constraintBottom_toTopOf="@id/appNameText"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.52"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="196dp"
        app:layout_constraintWidth_min="136dp"
        app:layout_constraintWidth_percent="0.30" />

    <TextView
        android:id="@+id/appNameText"
        style="@style/TextAppearance.Material3.DisplaySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:gravity="center"
        android:scaleX="0.96"
        android:scaleY="0.96"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toTopOf="@id/footerGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandLogo" />

    <LinearLayout
        android:id="@+id/footerGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/developerText"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/developer_credit"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/versionText"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
